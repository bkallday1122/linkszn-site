---
import Layout from '../../layouts/Layout.astro';
import {amazonProductUrl} from '../../lib/affiliates';
import {deals,money,date} from '../../lib/deals';
export function getStaticPaths(){return deals.map(deal=>({params:{slug:deal.slug},props:{deal}}));}
const {deal:d}=Astro.props;
const amazonUrl = d.amazon_asin ? amazonProductUrl(d.amazon_asin) : null;
---
<Layout title={d.title} description={d.writeup} image={d.image}><p class="disclosure">We may earn a commission from links on this page. <a href="/disclosure/">Affiliate disclosure</a></p><a class="back" href="/">← All deals</a><article data-deal-expires={d.expires_at}><div class="product"><img src={d.image} alt={d.title} width="600" height="500"/></div><div><div class="eyebrow">{d.category || 'Deal analysis'} · {d.condition || 'New'}</div><h1>{d.title}</h1><span class="badge" data-deal-badge>{d.pct_below}% below market</span><p class="price">{money(d.price)} <small>at Woot</small></p><a class="button" href={d.woot_url} data-deal-buy rel="sponsored nofollow noopener">Buy at Woot ↗</a>{d.expires_at && <p class="fine">Scheduled end: {date(d.expires_at)}. This page remains available as a price archive after the offer ends.</p>}<p class="fine">Posted {date(d.posted_at)}<br/>Price checked {date(d.checked_at || d.posted_at)}</p></div></article><section class="prose"><h2>Why this made the cut</h2><p>{d.writeup}</p><h2>The price check</h2><table><thead><tr><th scope="col">Retailer</th><th scope="col">Price checked</th><th scope="col">Details</th></tr></thead><tbody><tr><th scope="row">Woot</th><td>{money(d.price)}</td><td>{d.condition || 'New'}</td></tr>{d.comparisons.map(c=><tr><th scope="row"><a href={c.url} rel="nofollow noopener">{c.store} ↗</a></th><td>{money(c.price)}</td><td>{c.notes || 'Matching model and condition'}<br/><small>{date(c.checked_at || d.checked_at || d.posted_at)}</small></td></tr>)}</tbody></table><p class="fine">Savings compare the Woot item price with the lowest listed qualifying comparison, rounded down. Taxes and shipping are excluded unless specifically noted. Retailer prices and stock can change after checking.</p>{d.notes && <><h2>Before you buy</h2><p>{d.notes}</p></>}<p>See <a href="/about/">our verification approach</a> or <a href="/contact/">report a price change</a>.</p></section>{amazonUrl && <section class="prose amazon-comparison" aria-labelledby="amazon-heading"><h2 id="amazon-heading">Compare at Amazon</h2><p>{d.amazon_match_notes}</p><a class="button" href={amazonUrl} rel="sponsored nofollow noopener">Check price on Amazon ↗</a><p class="fine">Amazon affiliate link — we may earn a commission from qualifying purchases. Confirm the selected size, color, quantity, seller and current price on Amazon. Amazon prices are not included in the savings calculation above.</p></section>}</Layout>
<style>.amazon-comparison{border-top:1px solid #d9dfd5;padding-top:20px}.back{display:inline-block;margin:25px 0;font-size:13px}article{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}.product{background:white;border-radius:15px;padding:30px}.product img{width:100%;height:380px;object-fit:contain}h1{font-size:39px;letter-spacing:-1.4px;line-height:1.15}.price{font-size:39px;font-weight:800;margin:22px 0}.price small{font-size:14px;font-weight:400}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:left;padding:15px 8px;border-bottom:1px solid #d9dfd5}small{font-size:11px;color:var(--muted)}@media(max-width:700px){article{grid-template-columns:1fr;gap:25px}.product img{height:260px}h1{font-size:32px}th,td{padding:12px 5px;font-size:12px}}</style>
