---
import Layout from '../layouts/Layout.astro';
import DealCard from '../components/DealCard.astro';
import {deals} from '../lib/deals';
---
<Layout><section class="hero"><div><div class="eyebrow">THE GOOD STUFF. FOR A LOT LESS.</div><h1>It's always<br/><span>deal season.</span></h1><p>Woot finds worth your attention.<br/>Real price comparisons. A minimum 40% below market.</p><a class="button" href="#deals">Explore the latest ↓</a></div><aside><span class="eyebrow">OUR STANDARD</span><strong>40%<span>+</span></strong><p>below the lowest qualifying<br/>comparison price we checked.</p><a href="/about/">See how we check a deal ↗</a></aside></section><div class="promise"><span>↗ Independent price checks</span><span>◷ Every deal dated</span><span>✓ No MSRP-only savings claims</span></div><section id="deals"><div class="sectionhead"><div><div class="eyebrow">FRESH FINDS</div><h2>The latest deals</h2></div><span class="muted">{deals.length} researched finds</span></div><p class="disclosure">We may earn a commission from links on this page. <a href="/disclosure/">How our links work</a></p><div class="grid">{deals.map(d=><DealCard deal={d}/>)}</div>{deals.length===0 && <p>Our first price-verified finds are being prepared. Check back soon.</p>}</section><section class="follow"><div><h2>Catch the next good find.</h2><p>Follow LINKSZN on X for new deals as they're posted.</p></div><a class="button" href="https://x.com/LINKSZN">Follow @LINKSZN ↗</a></section></Layout>
<style>.hero{display:flex;justify-content:space-between;align-items:center;gap:45px;padding:45px 0 52px}.hero h1 span{color:var(--green)}.hero p{color:var(--muted);font-size:17px}.hero .button{margin-top:12px}aside{background:var(--lime);padding:34px;border-radius:14px;min-width:310px;transform:rotate(2deg);border:1px solid #bddf65}aside strong{display:block;font-size:100px;letter-spacing:-8px;line-height:1.2;margin-top:14px}aside strong span{font-size:55px}aside p{font-size:14px!important;color:#344d26!important}aside a{font-size:12px;font-weight:700}.promise{display:flex;justify-content:space-between;padding:23px 0;border-top:1px solid #d9dfd5;border-bottom:1px solid #d9dfd5;font-size:13px}.sectionhead{display:flex;justify-content:space-between;align-items:center;padding-top:45px}.sectionhead h2{font-size:30px;margin:9px 0}.sectionhead>span{font-size:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:23px;margin-top:25px}.follow{background:#e8eddf;padding:30px;margin-top:55px;border-radius:12px;display:flex;align-items:center;justify-content:space-between;gap:20px}.follow h2{margin:0}.follow p{font-size:14px;margin-bottom:0}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}aside{min-width:250px;padding:25px}aside strong{font-size:80px}}@media(max-width:650px){.hero{padding:25px 0;display:block}.hero aside{margin-top:30px;transform:none;min-width:0}aside strong{font-size:65px}.promise{flex-direction:column;gap:14px}.grid{grid-template-columns:1fr}.follow{display:block}.follow .button{margin-top:20px}}
</style>
