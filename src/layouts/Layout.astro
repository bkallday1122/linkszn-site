---
const {title='Real deals. Less noise.',description='Independent Woot deal research, real retailer price comparisons, and clear buying advice. Find your next steal with LINKSZN.',image='/social.svg'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | LINKSZN</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:site_name" content="LINKSZN"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:site" content="@LINKSZN"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,Astro.site)}/><link rel="icon" href="/favicon.svg"/></head><body><a class="skip" href="#main">Skip to content</a><div class="topline">LESS SCROLLING. BETTER DEALS.</div><header><a class="logo" href="/" aria-label="LINKSZN home">LINK<span>SZN</span><i>↗</i></a><nav aria-label="Main"><a href="/">Latest deals</a><a href="/about/">Our approach</a><a class="social" href="https://x.com/LINKSZN" rel="noopener">Follow on X ↗</a></nav></header><main id="main"><slot/></main><footer><div><a class="logo" href="/">LINK<span>SZN</span><i>↗</i></a><p>Good finds. Real comparisons. No inflated hype.</p></div><nav aria-label="Footer"><a href="/about/">About</a><a href="/disclosure/">Affiliate disclosure</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/contact/">Contact</a></nav><p class="fine">We may earn a commission from links on this site. As an Amazon Associate I earn from qualifying purchases. Prices and availability can change; confirm details at the retailer. © {new Date().getFullYear()} LINKSZN.</p></footer></body></html>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#19251e;background:#f6f7f2;font-synthesis:none;--green:#16533b;--lime:#d9ff73;--muted:#606b63}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}a:hover{color:#27704f}button,input{font:inherit}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #387cff;outline-offset:4px}.skip{position:absolute;top:-50px;background:white;padding:10px;z-index:9}.skip:focus{top:0}.topline{background:var(--green);color:var(--lime);text-align:center;padding:9px;font-size:10px;letter-spacing:2px;font-weight:700}header,main,footer{max-width:1240px;margin:auto;padding:28px 32px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d9dfd5}.logo{text-decoration:none;font-size:30px;font-weight:900;letter-spacing:-2px}.logo span{color:var(--green)}.logo i{font-style:normal;background:var(--lime);border-radius:50%;display:inline-flex;justify-content:center;align-items:center;width:29px;height:29px;margin-left:7px;font-size:22px;letter-spacing:0}nav{display:flex;gap:25px;align-items:center;font-size:14px}nav a{text-decoration:none}.social{border:1px solid #cad3c6;padding:11px 16px;border-radius:24px}h1{letter-spacing:-2px;font-size:clamp(38px,5.5vw,68px);line-height:1.04;margin:20px 0}h2{letter-spacing:-.7px}p{line-height:1.7}.eyebrow{text-transform:uppercase;color:var(--green);font-size:11px;font-weight:800;letter-spacing:1.8px}.muted,.fine{color:var(--muted)}.fine{font-size:12px}.button{background:var(--green);color:white;padding:13px 20px;text-decoration:none;border-radius:7px;display:inline-block;font-weight:700}.button:hover{background:#23734f;color:white}.badge{background:var(--lime);color:#204221;padding:7px 11px;border-radius:5px;font-size:12px;font-weight:800}.prose{max-width:780px;margin:30px auto 70px}.prose h1{font-size:48px}.prose h2{margin-top:35px}.prose p,.prose li{color:#465348;line-height:1.8}.disclosure{font-size:12px;padding:13px 0;border-bottom:1px solid #d9dfd5;color:var(--muted)}footer{border-top:1px solid #d9dfd5;display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-top:70px}footer p{font-size:13px}footer .fine{flex-basis:100%;max-width:870px}@media(max-width:650px){header,main,footer{padding:22px 18px}header nav{gap:12px;font-size:12px}.social{display:none}.logo{font-size:25px}footer nav{flex-wrap:wrap;gap:16px}.prose h1{font-size:38px}}
</style>

<script>
function markExpired(){
 document.querySelectorAll<HTMLElement>('[data-deal-expires]').forEach(card=>{
  const expiry=Date.parse(card.dataset.dealExpires || '');
  if(Number.isFinite(expiry) && expiry<=Date.now()){
   const badge=card.querySelector('[data-deal-badge]'); if(badge) badge.textContent='Offer ended · price archive';
   card.querySelectorAll('[data-deal-buy]').forEach(link=>link.textContent='Check availability ↗');
  }
 });
}
markExpired(); setInterval(markExpired,60000);
</script>
