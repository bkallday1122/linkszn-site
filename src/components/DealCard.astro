---
import {money,date} from '../lib/deals';
const {deal:d}=Astro.props;
---
<article data-deal-expires={d.expires_at} class="card"><a class="photo" href={`/deals/${d.slug}/`}><span class="badge" data-deal-badge>{d.pct_below}% below market</span><img src={d.image} alt={d.title} loading="lazy" width="420" height="300"/></a><div class="body"><div class="eyebrow">{d.category || 'The latest find'} · {d.condition || 'New'}</div><h2><a href={`/deals/${d.slug}/`}>{d.title}</a></h2><div class="price">{money(d.price)} <span>at Woot</span></div><p class="comparisons">{d.comparisons.map(c=>`${c.store} ${money(c.price)}`).join(' · ')}</p><div class="cardbottom"><time datetime={d.posted_at}>{date(d.posted_at)}</time><a class="button" href={d.woot_url} data-deal-buy rel="sponsored nofollow noopener">Buy ↗</a></div></div></article>
<style>.card{background:white;border:1px solid #e0e5db;border-radius:12px;overflow:hidden;display:flex;flex-direction:column}.photo{display:block;height:235px;position:relative;padding:28px;background:white}.photo .badge{position:absolute;left:16px;top:15px}.photo img{width:100%;height:100%;object-fit:contain}.body{padding:22px;border-top:1px solid #eef0e9;display:flex;flex-direction:column;flex:1}h2{font-size:19px;line-height:1.35;margin:12px 0 16px}h2 a{text-decoration:none}.price{font-size:29px;font-weight:800;letter-spacing:-1px}.price span{font-size:12px;font-weight:400;letter-spacing:0;color:var(--muted)}.comparisons{font-size:12px;color:var(--muted);margin:8px 0 22px}.cardbottom{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto}time{font-size:10px;color:var(--muted);max-width:130px;line-height:1.5}.button{padding:10px 17px;font-size:13px}</style>
