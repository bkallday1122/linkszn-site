---
const {slug}=Astro.props;
---
<div class="vote-pill" data-vote-slug={slug} role="group" aria-label="Good Deal?">
  <span class="vp-label">Good Deal?</span>
  <button type="button" class="vp-up" data-v="1" aria-label="Thumbs up">👍</button>
  <span class="vp-score" aria-live="polite">0</span>
  <button type="button" class="vp-down" data-v="-1" aria-label="Thumbs down">👎</button>
</div>
<style>
.vote-pill{display:inline-flex;align-items:center;gap:.5rem;border:1px solid #d0d7de;border-radius:999px;padding:.3rem .7rem;margin:.75rem 0;font-weight:600;background:#fff}
.vote-pill button{border:0;border-radius:999px;width:2.1rem;height:2.1rem;cursor:pointer;font-size:1.05rem;color:#fff}
.vp-up{background:#1a73e8}.vp-down{background:#f57c00}
.vote-pill button[aria-pressed="true"]{outline:3px solid #111;outline-offset:1px}
.vote-pill button:disabled{opacity:.6;cursor:default}
.vp-score{min-width:2ch;text-align:center}
</style>
<script>
for (const el of document.querySelectorAll('[data-vote-slug]')) {
  const slug=el.dataset.voteSlug, key='lzvote:'+slug, sc=el.querySelector('.vp-score');
  const show=d=>{ if(d&&typeof d.score==='number') sc.textContent=(d.score>0?'+':'')+d.score; };
  const mark=v=>el.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.v===v)));
  mark(+localStorage.getItem(key)||0);
  fetch('/api/vote?slug='+encodeURIComponent(slug)).then(r=>r.json()).then(show).catch(()=>{});
  el.addEventListener('click',async e=>{
    const b=e.target.closest('button'); if(!b) return;
    const vote=+b.dataset.v, prev=+localStorage.getItem(key)||0; if(vote===prev) return;
    el.querySelectorAll('button').forEach(x=>x.disabled=true);
    try{ const r=await fetch('/api/vote',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({slug,vote,prev})});
      const d=await r.json(); if(r.ok){localStorage.setItem(key,String(vote)); mark(vote);} show(d);
    }catch{} el.querySelectorAll('button').forEach(x=>x.disabled=false);
  });
}
</script>
